    "[development]": {
      "features": {
        "demo_import": true
      }
    },
    "[test]": {
      "features": {
        "demo_import": true
      }
    },
    "[production]": {
      "features": {
        "demo_import": false
      }
    },
    "[hybrid]": {
      "features": {
        "demo_import": false
      }
