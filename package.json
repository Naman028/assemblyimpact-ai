{
  "name": "assemblyimpact-ai",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3.1.2",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.16.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "eslint": "9.39.5"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "dev:gemini": "cds watch --profile development,gemini",
    "demo:init": "cds deploy --to sqlite:db/demo.sqlite --no-save",
    "demo": "cds-serve --profile demo",
    "test": "node --test test/assembly-service.test.js test/impact-calculator.test.js test/engineering-review.test.js test/seed-data.test.js test/case-worklist-app.test.js test/m05-run-impact-ui.test.js test/assembly-visuals.test.js test/m04-review-decisions.test.js test/m05-review-workflow.test.js test/m05-scenarios.test.js test/m05-import.test.js test/m05-investigation-studio.test.js test/p2-erp-adapter.test.js test/p2-genai-explanation.test.js test/p2-gemini-provider.test.js test/p1-actions-contract.test.js test/p1-joule-mapping.test.js test/btp-deployment-config.test.js test/demo-data.test.js test/coverage.test.js test/planning-and-hints.test.js test/ui-landing-startup.test.js test/runtime-contract.test.js",
    "lint": "eslint srv test --max-warnings=0",
    "build:btp": "mbt build -t mta_archives"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "sapux": [
    "app/case-worklist",
    "app/investigation-studio",
    "app/home"
  ],
  "cds": {
    "runtime": {
      "patch_as_upsert": false,
      "put_as_upsert": false
    },
    "query": {
      "limit": {
        "default": 100,
        "max": 1000
      }
    },
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "*": false,
            "developer": {
              "password": "development-only",
              "roles": [
                "AssemblyMaintainer"
              ],
              "attr": {
                "plants": [
                  "1000"
                ]
              }
            },
            "alice": false,
            "bob": false,
            "carol": false,
            "dave": false,
            "erin": false,
            "fred": false,
            "me": false,
            "yves": false,
            "analyst": {
              "password": "development-only",
              "roles": [
                "ChangeAnalyst",
                "DemoDataImporter",
                "ErpExtractor"
