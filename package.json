        },
        "genai": {
          "provider": "fixture",
          "fixture": "test/fixtures/p2/genai/answers.json"
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "erp-source": {
          "fixtures": null,
          "sandbox": null,
          "s4": {
            "enabled": false
          },
          "mode": "NONE"
        },
        "db": {
          "kind": "hana"
        },
        "genai": {
          "provider": "gemini",
          "modelId": "gemini-3.5-flash-lite",
          "apiKeyEnv": "GEMINI_API_KEY",
          "timeoutMs": 20000
        }
      },
      "erp-source": {
        "fixtures": "test/fixtures/p2/s4-contract",
        "sandbox": {
          "url": "https://sandbox.api.sap.com/s4hanacloud",
          "apiKeyEnv": "SAP_API_HUB_KEY"
        },
        "s4": {
          "enabled": false
        }
      },
      "[hybrid]": {
        "auth": {
          "kind": "xsuaa"
        },
        "db": {
          "kind": "hana"
        },
        "erp-source": {
          "fixtures": null,
          "s4": {
            "enabled": false
          },
          "mode": "NONE"
        }
      },
      "genai-hub": {
        "kind": "rest",
        "credentials": {
          "destination": "ASSEMBLYIMPACT_GENAI_HUB"
        }
      },
      "genai": {
        "provider": null,
        "service": "genai-hub",
        "resourceGroup": null,
        "deploymentId": null,
        "apiVersion": "2024-02-01"
      },
      "[gemini]": {
        "genai": {
          "provider": "gemini",
          "modelId": "gemini-3.5-flash-lite",
          "apiKeyEnv": "GEMINI_API_KEY",
          "timeoutMs": 20000
        }
      }
