{
  "_version": "1.65.0",
  "sap.app": {
    "crossNavigation": { "inbounds": { "AssemblyImpact-overview": { "semanticObject": "AssemblyImpact", "action": "overview", "title": "AssemblyImpact AI", "signature": { "parameters": {}, "additionalParameters": "allowed" } } } },
    "id": "assemblyimpact.home",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "0.1.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": { "uri": "/odata/v4/engineering-review/", "type": "OData", "settings": { "odataVersion": "4.0" } }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": { "viewName": "assemblyimpact.home.view.Home", "type": "XML", "id": "home" },
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.m": {}, "sap.f": {}, "sap.ui.core": {}, "sap.ui.layout": {} }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "assemblyimpact.home.i18n.i18n", "supportedLocales": [""], "fallbackLocale": "" } }
    },
    "resources": { "css": [{ "uri": "css/style.css" }] }
  }
}
