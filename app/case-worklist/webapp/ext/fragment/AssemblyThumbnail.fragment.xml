<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- Same availability rule as AssemblyIllustration: COOL-100-B. -->
	<Image src="{= 'assets/assemblies/' + ${assemblyCode} + '-' + ${toRevision} + '-thumb.svg' }"
		visible="{= (${path: 'assemblyCode', targetType: 'any'} + '-' + ${path: 'toRevision', targetType: 'any'}) === 'COOL-100-B' }"
		alt="{= 'Synthetic illustration of assembly ' + ${assemblyCode} + ', revision ' + ${toRevision} }"
		decorative="false" densityAware="false" width="3rem" height="2rem" class="aiAssemblyThumb"/>
</core:FragmentDefinition>
