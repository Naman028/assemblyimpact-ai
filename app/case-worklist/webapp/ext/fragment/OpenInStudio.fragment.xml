<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- P3 -> P4: open this case in the Investigation Studio (same case, no new selection needed).
	     Both apps are served as /<app>/webapp/ locally and behind the app router, so the relative path works in both.
	     Plain href expression binding, no formatter module (not loaded in Fiori elements custom fragments). -->
	<HBox alignItems="Center" class="sapUiSmallMarginTop">
		<Link text="Open this case in the Investigation Studio" emphasized="true"
			href="{= '../../investigation-studio/webapp/index.html#/cases/' + ${ID} }"/>
		<Text class="sapUiSmallMarginBegin"
			text="Component-level BOM comparison, stock and cost evidence, instructions and review actions for this case."/>
	</HBox>
</core:FragmentDefinition>
